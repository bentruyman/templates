{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun",
    "db:down": "sh ./scripts/compose.sh down --volumes --remove-orphans",
    "db:generate": "drizzle-kit generate",
    "db:init": "bun run db:up && bun run db:migrate",
    "db:logs": "sh ./scripts/compose.sh logs -f db",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "sh ./scripts/compose.sh up -d db && until sh ./scripts/compose.sh exec -T db pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-app}; do sleep 1; done",
    "dev": "bun run --hot src/index.ts",
    "format": "oxfmt && oxlint --fix",
    "lint": "oxfmt --check && oxlint .",
    "prepare": "husky",
    "test": "bun run db:init && bun test",
    "typecheck": "tsc",
    "verify": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.11",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  }
}
