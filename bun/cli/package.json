{
  "name": "cli",
  "description": "",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cli": "./dist/index.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm",
    "format": "oxfmt",
    "prepare": "husky",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "release": "release-it",
    "typecheck": "tsc"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@truyman/cli": "latest",
    "kleur": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9",
    "lint-staged": "^16",
    "oxfmt": "^0.21.0",
    "release-it": "^19",
    "typescript": "^5"
  }
}
