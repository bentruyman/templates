{
  "name": "cli",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "bin": {
    "cli": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt && oxlint --fix",
    "lint": "oxfmt --check && oxlint .",
    "prepare": "husky",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "release": "release-it",
    "test": "vitest run",
    "typecheck": "tsc",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@truyman/cli": "^1",
    "kleur": "^4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "^9",
    "lint-staged": "^16",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "release-it": "^19",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
